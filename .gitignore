# Large media files - exclude videos and PDFs from git
*.mp4
*.avi
*.mov
*.mkv
*.pdf

# Obsidian vault - exclude from git (too large with videos/PDFs)
frontend/public/obsidian/

# Keep only scribble PNG files, exclude everything else
frontend/public/scribble/**/*
!frontend/public/scribble/**/*.png

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.spec

# Build artifacts (compiled binaries should not be in source control)
dist/
build/
output/

# Runtime outputs
monitor.log
*.log

# Config with secrets / local overrides
.env
config.local.json

# Node modules
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
