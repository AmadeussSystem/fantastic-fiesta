{
  "name": "fantastic-fiesta-frontend",
  "version": "1.0.0",
  "description": "DSA Learning Roadmap - A stunning SolidJS frontend",
  "type": "module",
  "scripts": {
    "dev": "npm run prebuild && npm run dev:watch",
    "dev:watch": "concurrently \"node ../scripts/watch_notes.js\" \"vite\"",
    "watch": "node ../scripts/watch_notes.js",
    "prebuild": "node ../scripts/prepare_notes.js",
    "build": "npm run prebuild && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^17.0.1",
    "remark-gfm": "^4.0.0",
    "solid-js": "^1.8.7",
    "solid-markdown": "^2.0.0"
  },
  "devDependencies": {
    "@unocss/preset-icons": "^0.58.0",
    "@unocss/preset-uno": "^0.58.0",
    "@unocss/preset-web-fonts": "^0.58.0",
    "@unocss/reset": "^0.58.0",
    "buffer": "^6.0.3",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "unocss": "^0.58.0",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-solid": "^2.8.0"
  }
}
